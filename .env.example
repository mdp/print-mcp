# Generate with: openssl rand -hex 32. This token may also be used in /mcp/<token>
MCP_BEARER_TOKEN=replace-with-at-least-32-random-characters

# CUPS web administration at http://CUPS_BIND_IP:631/admin
CUPS_ADMIN_USER=printadmin
CUPS_ADMIN_PASSWORD=replace-with-a-long-random-password

# Safe default is localhost. Set this to this host's Tailscale IP for remote CUPS access.
CUPS_BIND_IP=127.0.0.1
CUPS_PORT=631
# Comma-separated IPs/CIDRs allowed to browse and print. Tailscale IPv4 range shown.
CUPS_ALLOWED_NETWORKS=100.64.0.0/10

# Auto-configure an IPP Everywhere queue at container start, enabled + default.
# Leave empty to skip auto-setup and add queues manually.
CUPS_PRINTER_IP=
CUPS_PRINTER_NAME=printer

# Optional CUPS queue used when print_markdown does not specify one.
DEFAULT_PRINTER=
DEFAULT_PAGE_SIZE=letter
DEFAULT_MARGIN_MM=17.8
MCP_PORT=8000
MCP_ALLOWED_ORIGINS=
# Comma-separated Host headers accepted by MCP. Add the Cloudflare public hostname.
MCP_ALLOWED_HOSTS=

# Required only when starting the tunnel profile.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.6.1
